{
  "extends": "@content-desk/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@desktop/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "tests",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
